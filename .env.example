# EventSaathi AI Environment Configuration Example

# Backend Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./eventsaathi.db

# AI Provider Settings (Google Gemini)
AI_PROVIDER=gemini
# Provide your Google Gemini API key to activate live Gemini generative AI planning
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=25

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
