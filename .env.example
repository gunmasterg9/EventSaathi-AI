# EventSaathi AI Environment Configuration Example

# Backend Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./eventsaathi.db

# AI Provider Settings
AI_PROVIDER=gemini
# Optional local testing: AI_PROVIDER=ollama (or use run-ollama.bat)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_TIMEOUT_SECONDS=180
# Leave GEMINI_API_KEY blank to automatically test the reliable deterministic fallback planner
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
