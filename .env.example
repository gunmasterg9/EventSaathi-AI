# EventSaathi AI Environment Configuration Example

# Backend Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///./eventsaathi.db

# AI Provider Settings
# Leave GEMINI_API_KEY blank to automatically test the reliable deterministic fallback planner
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
